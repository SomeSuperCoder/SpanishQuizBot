{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "",
        "baseURL": "https://opencode.ai/zen/v1"
      }
    }
  },
  "agent": {
    "quiz-generator": {
      "description": "Genera quizzes de español para estudiantes rusohablantes",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "quiz-reviewer": {
      "description": "Revisa y corrige quizzes de español para estudiantes rusohablantes",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "experimental": {
    "primary_tools": ["edit"]
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "instructions": []
}
